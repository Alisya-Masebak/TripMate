<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFFA"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#245B55"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your travel profile and preferences."
            android:textColor="#858292"
            android:textSize="13sp" />

        <!-- Profile header card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="166dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_profile_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="18dp">

            <TextView
                android:id="@+id/tvProfileInitial"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_profile_avatar"
                android:gravity="center"
                android:text="T"
                android:textColor="#245B55"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Loading profile..."
                android:textColor="#245B55"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Loading email..."
                android:textColor="#858292"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Account section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="ACCOUNT"
            android:textColor="#858292"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Personal information -->
        <LinearLayout
            android:id="@+id/rowPersonalInformation"
            style="@style/ProfileSettingRow">

            <TextView
                style="@style/ProfileSettingIcon"
                android:backgroundTint="#DDEBE2"
                android:text="P" />

            <LinearLayout
                style="@style/ProfileSettingTextContainer">

                <TextView
                    style="@style/ProfileSettingTitle"
                    android:text="Personal information" />

                <TextView
                    style="@style/ProfileSettingSubtitle"
                    android:text="Update your name and email" />

            </LinearLayout>

            <TextView
                style="@style/ProfileSettingChevron"
                android:text="›" />

        </LinearLayout>

        <!-- Travel preferences -->
        <LinearLayout
            android:id="@+id/rowTravelPreferences"
            style="@style/ProfileSettingRow">

            <TextView
                style="@style/ProfileSettingIcon"
                android:backgroundTint="#E8DDF3"
                android:text="T" />

            <LinearLayout
                style="@style/ProfileSettingTextContainer">

                <TextView
                    style="@style/ProfileSettingTitle"
                    android:text="Travel preferences" />

                <TextView
                    style="@style/ProfileSettingSubtitle"
                    android:text="Manage your travel interests" />

            </LinearLayout>

            <TextView
                style="@style/ProfileSettingChevron"
                android:text="›" />

        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/rowNotifications"
            style="@style/ProfileSettingRow">

            <TextView
                style="@style/ProfileSettingIcon"
                android:backgroundTint="#F5DCE8"
                android:text="N" />

            <LinearLayout
                style="@style/ProfileSettingTextContainer">

                <TextView
                    style="@style/ProfileSettingTitle"
                    android:text="Notifications" />

                <TextView
                    style="@style/ProfileSettingSubtitle"
                    android:text="Manage trip reminders" />

            </LinearLayout>

            <TextView
                style="@style/ProfileSettingChevron"
                android:text="›" />

        </LinearLayout>

        <!-- Privacy and security -->
        <LinearLayout
            android:id="@+id/rowPrivacySecurity"
            style="@style/ProfileSettingRow">

            <TextView
                style="@style/ProfileSettingIcon"
                android:backgroundTint="#E8E5F2"
                android:text="S" />

            <LinearLayout
                style="@style/ProfileSettingTextContainer">

                <TextView
                    style="@style/ProfileSettingTitle"
                    android:text="Privacy and security" />

                <TextView
                    style="@style/ProfileSettingSubtitle"
                    android:text="Password and account security" />

            </LinearLayout>

            <TextView
                style="@style/ProfileSettingChevron"
                android:text="›" />

        </LinearLayout>

        <!-- Support section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SUPPORT"
            android:textColor="#858292"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowHelpSupport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Help and support"
                android:textColor="#245B55"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#858292"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Logout -->
        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_profile_logout"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Log out"
            android:textColor="#9C536C"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
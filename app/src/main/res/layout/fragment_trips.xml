<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFFA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Trips"
            android:textColor="#245B55"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Every journey starts with a plan."
            android:textColor="#858092"
            android:textSize="14sp" />

        <!-- Travel banner -->
        <ImageView
            android:id="@+id/imgTripsBanner"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginTop="22dp"
            android:contentDescription="Travel scenery banner"
            android:scaleType="centerCrop"
            android:src="@drawable/home_travel_banner"
            android:background="@drawable/bg_image_rounded" />

        <!-- Search Input -->
        <EditText
            android:id="@+id/etSearchTrips"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input"
            android:hint="Search trips..."
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#245B55"
            android:textColorHint="#858092"
            android:textSize="14sp" />

        <!-- Section heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Your journeys"
            android:textColor="#245B55"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Filters -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_filter_selected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="All trips"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/filterUpcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="Upcoming"
                    android:textColor="#245B55"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/filterCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="Completed"
                    android:textColor="#245B55"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Japan Adventure card -->
        <LinearLayout
            android:id="@+id/japanTripCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_trip_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Destination image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="155dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Mount Fuji in Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_mount_fuji" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="JAPAN"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_filter_selected"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="UPCOMING"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Trip information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Japan Adventure"
                android:textColor="#245B55"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="12–18 Dec 2026"
                android:textColor="#858092"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="7 days"
                    android:textColor="#245B55"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="3 cities"
                    android:textColor="#245B55"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Japan"
                    android:textColor="#245B55"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#E9E2EF" />

            <TextView
                android:id="@+id/btnTripDetails"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="View trip details"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/emptyTripsState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="170dp"
                android:layout_height="145dp"
                android:contentDescription="No trips illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/empty_trips" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No trips found"
                android:textColor="#245B55"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Try another filter or search."
                android:textColor="#858092"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Create trip prompt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_inspiration"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready for another adventure?"
                android:textColor="#245B55"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Plan your next journey and make new memories."
                android:textColor="#858092"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnCreateTrip"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="+ Create new trip"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

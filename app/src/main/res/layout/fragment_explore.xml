<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore"
            android:textColor="#245B55"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Find your next favourite destination."
            android:textColor="#858092"
            android:textSize="14sp"/>

        <!-- Search -->
        <EditText
            android:id="@+id/etSearchDestinations"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_search_field"
            android:hint="Search destinations..."
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#245B55"
            android:textColorHint="#858092"
            android:textSize="14sp"/>

        <!-- Banner -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_image_rounded"
            android:contentDescription="Travel inspiration"
            android:scaleType="centerCrop"
            android:src="@drawable/home_travel_banner"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Discover places"
            android:textColor="#245B55"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <!-- Categories -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/categoryAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_filter_selected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/categoryNature"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="Nature"
                    android:textColor="#245B55"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/categoryCulture"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="Culture"
                    android:textColor="#245B55"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/categoryCity"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_filter_unselected"
                    android:gravity="center"
                    android:paddingStart="19dp"
                    android:paddingEnd="19dp"
                    android:text="City"
                    android:textColor="#245B55"
                    android:textSize="12sp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Destination cards -->
        <LinearLayout
            android:id="@+id/destinationList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- Kyoto -->
            <LinearLayout
                android:id="@+id/cardKyoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_trip_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:contentDescription="Kyoto Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_kyoto"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Kyoto, Japan"
                    android:textColor="#245B55"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Temples, traditional streets and culture"
                    android:textColor="#858092"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Osaka -->
            <LinearLayout
                android:id="@+id/cardOsaka"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_trip_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:contentDescription="Osaka Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_osaka"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Osaka, Japan"
                    android:textColor="#245B55"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Street food, shopping and nightlife"
                    android:textColor="#858092"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Tokyo -->
            <LinearLayout
                android:id="@+id/cardTokyo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_trip_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:contentDescription="Tokyo Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_tokyo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tokyo, Japan"
                    android:textColor="#245B55"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Modern city life and iconic attractions"
                    android:textColor="#858092"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Nara -->
            <LinearLayout
                android:id="@+id/cardNara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_trip_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:contentDescription="Nara Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_nara"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nara, Japan"
                    android:textColor="#245B55"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nature, peaceful parks and friendly deer"
                    android:textColor="#858092"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Mount Fuji -->
            <LinearLayout
                android:id="@+id/cardMountFuji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_trip_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:contentDescription="Mount Fuji Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_mount_fuji"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mount Fuji, Japan"
                    android:textColor="#245B55"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mountain scenery and outdoor adventures"
                    android:textColor="#858092"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Fushimi Inari -->
            <LinearLayout
                android:id="@+id/cardFushimi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_trip_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:contentDescription="Fushimi Inari Japan"
                    android:scaleType="centerCrop"
                    android:src="@drawable/destination_fushimi_inari"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Fushimi Inari, Kyoto"
                    android:textColor="#245B55"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Iconic shrine and beautiful red torii gates"
                    android:textColor="#858092"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvNoDestinations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="30dp"
            android:text="No destinations found."
            android:textColor="#858092"
            android:textSize="14sp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>
